{
  "name": "dangtiendat-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-placeholders.mjs && node scripts/build-client.mjs",
    "build": "next build --webpack",
    "postbuild": "node scripts/postbuild.mjs",
    "start": "node scripts/serve.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "size": "node scripts/js-size.mjs",
    "predev": "node scripts/build-client.mjs",
    "measure:fps": "node scripts/measure-fps.mjs",
    "measure:lighthouse": "node scripts/lighthouse.mjs",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^18.2.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "puppeteer-core": "^25.17.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  }
}
